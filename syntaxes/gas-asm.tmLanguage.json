                },
                {
                    "name": "keyword.mnemonic.bmi.gas-asm",
                    "match": "\\b(andn[lq]?|bextr[lq]?|blsi[lq]?|blsmsk[lq]?|blsr[lq]?|bzhi[lq]?|lzcnt[lq]?|tzcnt[lq]?|mulx[lq]?|pdep[lq]?|pext[lq]?|rorx[lq]?|sarx[lq]?|shlx[lq]?|shrx[lq]?)\\b"
