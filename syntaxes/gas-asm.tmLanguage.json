                {
                    "name": "variable.language.register.gpr.gas-asm",
                    "match": "%e(ax|bx|cx|dx|si|di|bp|sp|ip)\\b|%r(8|9|1[0-5])d\\b"
                },
                {
                    "name": "variable.language.register.gpr.gas-asm",
                    "match": "%(ax|bx|cx|dx|si|di|bp|sp|ip)\\b|%r(8|9|1[0-5])w\\b"
                },
                {
                    "name": "variable.language.register.gpr.gas-asm",
                    "match": "%([abcd][hl]|[sd]il|[sb]pl|r(8|9|1[0-5])b)\\b"
                },
                {
                    "name": "variable.language.register.segment.gas-asm",
                    "match": "%(cs|ds|es|fs|gs|ss)\\b"
                },
                {
                    "name": "variable.language.register.control.gas-asm",
                    "match": "%cr[0-8]\\b"
                },
                {
                    "name": "variable.language.register.debug.gas-asm",
                    "match": "%dr[0-7]\\b"
                },
                {
                    "name": "variable.language.register.test.gas-asm",
                    "match": "%tr[3-7]\\b"
                },
                {
                    "name": "variable.language.register.fpu.gas-asm",
                    "match": "%st(\\([0-7]\\))?\\b"
                },
                {
                    "name": "variable.language.register.mmx.gas-asm",
                    "match": "%mm[0-7]\\b"
                },
                {
                    "name": "variable.language.register.xmm.gas-asm",
                    "match": "%xmm([0-9]|1[0-5]|2[0-9]|3[01])\\b"
                },
                {
                    "name": "variable.language.register.ymm.gas-asm",
                    "match": "%ymm([0-9]|1[0-5]|2[0-9]|3[01])\\b"
                },
                {
                    "name": "variable.language.register.zmm.gas-asm",
                    "match": "%zmm([0-9]|1[0-5]|2[0-9]|3[01])\\b"
                },
                {
                    "name": "variable.language.register.mask.gas-asm",
                    "match": "%k[0-7]\\b"
                },
                {
                    "name": "variable.language.register.bound.gas-asm",
                    "match": "%bnd[0-3]\\b"
                },
                {
                    "name": "variable.language.register.tmm.gas-asm",
                    "match": "%tmm([0-7])\\b"
                },
                {
                    "name": "variable.language.register.flags.gas-asm",
                    "match": "%(e?flags|r?flags)\\b"
                }
            ]
        },
        "immediates": {
            "patterns": [
                {
                    "name": "constant.numeric.hex.gas-asm",
                    "match": "\\$-?0[xX][0-9a-fA-F]+\\b"
                },
                {
                    "name": "constant.numeric.binary.gas-asm",
                    "match": "\\$-?0[bB][01]+\\b"
                },
                {
                    "name": "constant.numeric.octal.gas-asm",
                    "match": "\\$-?0[0-7]+\\b"
                },
                {
                    "name": "constant.numeric.float.gas-asm",
                    "match": "\\$-?[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?\\b"
                },
                {
                    "name": "constant.numeric.decimal.gas-asm",
                    "match": "\\$-?[0-9]+\\b"
                }
            ]
        },
        "memory-operands": {
            "patterns": [
                {
                    "name": "meta.memory-operand.gas-asm",
                    "match": "(-?[0-9]+)?\\((%[a-z0-9]+)(,\\s*%[a-z0-9]+)?(,\\s*[1248])?\\)",
                    "captures": {
                        "1": {
                            "name": "constant.numeric.displacement.gas-asm"
                        },
                        "2": {
                            "name": "variable.language.register.base.gas-asm"
                        }
                    }
                },
                {
                    "name": "meta.rip-relative.gas-asm",
                    "match": "([a-zA-Z_][a-zA-Z0-9_]*)\\(%rip\\)",
                    "captures": {
                        "1": {
                            "name": "entity.name.label.gas-asm"
                        }
                    }
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.arithmetic.gas-asm",
                    "match": "[+\\-*/&|^~]|<<|>>"
                },
                {
                    "name": "keyword.operator.addressing.gas-asm",
                    "match": "[@$%]"
                },
                {
                    "name": "punctuation.separator.gas-asm",
                    "match": "[,:]"
                },
                {
                    "name": "punctuation.section.parens.gas-asm",
                    "match": "[()]"
                }
            ]
        }
    }
}