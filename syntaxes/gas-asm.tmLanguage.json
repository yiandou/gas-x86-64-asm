{
    "name": "GAS x86-64 Assembly (AT&T)",
    "scopeName": "source.gas-asm",
    "fileTypes": [
        "s",
        "S",
        "gas-asm"
    ],
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#preprocessor"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#labels"
        },
        {
            "include": "#directives"
        },
        {
            "include": "#instructions"
        },
        {
            "include": "#registers"
        },
        {
            "include": "#immediates"
        },
        {
            "include": "#memory-operands"
        },
        {
            "include": "#operators"
        }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.line.number-sign.gas-asm",
                    "match": "#.*$"
                },
                {
                    "name": "comment.block.gas-asm",
                    "begin": "/\\*",
                    "end": "\\*/"
                },
                {
                    "name": "comment.line.double-slash.gas-asm",
                    "match": "//.*$"
                }
            ]
        },
        "preprocessor": {
            "patterns": [
                {
                    "name": "meta.preprocessor.gas-asm",
                    "match": "^\\s*#\\s*(include|define|undef|ifdef|ifndef|if|elif|else|endif|error|warning|pragma|line)\\b.*$",
                    "captures": {
                        "1": {
                            "name": "keyword.control.directive.preprocessor.gas-asm"
                        }
                    }
                }
            ]
        },
        "strings": {
            "patterns": [
                {
                    "name": "string.quoted.double.gas-asm",
                    "begin": "\"",
                    "end": "\"",
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.end.gas-asm"
                        }
                    },
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.begin.gas-asm"
                        }
                    },
                    "patterns": [
                        {
                            "name": "constant.character.escape.gas-asm",
                            "match": "\\\\."
                        }
                    ]
                },
                {
                    "name": "string.quoted.single.gas-asm",
                    "begin": "'",
                    "end": "'",
                    "endCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.end.gas-asm"
                        }
                    },
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.string.begin.gas-asm"
                        }
                    },
                    "patterns": [
                        {
                            "name": "constant.character.escape.gas-asm",
                            "match": "\\\\."
                        }
                    ]
                }
            ]
        },
        "labels": {
            "patterns": [
                {
                    "name": "entity.name.function.label.gas-asm",
                    "match": "^\\s*([a-zA-Z_\\.][a-zA-Z0-9_\\.]*)\\s*:",
                    "captures": {
                        "1": {
                            "name": "entity.name.label.gas-asm"
                        }
                    }
                },
                {
                    "name": "entity.name.function.label.local.gas-asm",
                    "match": "^\\s*([0-9]+)\\s*:",
                    "captures": {
                        "1": {
                            "name": "entity.name.label.local.gas-asm"
                        }
                    }
                }
            ]
        },
        "directives": {
            "patterns": [
                {
                    "name": "keyword.control.directive.section.gas-asm",
                    "match": "\\.(text|data|bss|rodata|section|subsection|previous|pushsection|popsection|init|fini|ctors|dtors|tdata|tbss)\\b"
                },
                {
                    "name": "keyword.control.directive.alignment.gas-asm",
                    "match": "\\.(align|balign|p2align|p2alignw|p2alignl)\\b"
                },
                {
                    "name": "keyword.control.directive.data.gas-asm",
                    "match": "\\.(byte|2byte|4byte|8byte|word|short|hword|int|long|quad|octa|float|single|double|tfloat|ascii|asciz|string|string8|string16|string32|string64|zero|space|skip|fill|org|dc|ds|dcb|value)\\b"
                },
                {
                    "name": "keyword.control.directive.symbol.gas-asm",
                    "match": "\\.(globl|global|weak|local|comm|lcomm|equ|equiv|eqv|set|extern|type|size|hidden|protected|internal|visibility)\\b"
                },
                {
                    "name": "keyword.control.directive.cfi.gas-asm",
                    "match": "\\.(cfi_startproc|cfi_endproc|cfi_def_cfa|cfi_def_cfa_offset|cfi_def_cfa_register|cfi_offset|cfi_restore|cfi_undefined|cfi_same_value|cfi_remember_state|cfi_restore_state|cfi_return_column|cfi_signal_frame|cfi_window_save|cfi_escape|cfi_val_encoded_addr|cfi_label|cfi_sections|cfi_personality|cfi_lsda|cfi_val_offset|cfi_rel_offset|cfi_adjust_cfa_offset|cfi_register)\\b"
                },
                {
                    "name": "keyword.control.directive.debug.gas-asm",
                    "match": "\\.(file|ident|loc|loc_mark_labels|line|def|dim|endef|scl|tag|val)\\b"
                },
                {
                    "name": "keyword.control.directive.macro.gas-asm",
                    "match": "\\.(macro|endm|exitm|purgem|rept|endr|irp|irpc|ifc|ifnc|ifeq|ifne|ifge|ifgt|ifle|iflt|ifnotdef|ifdef|ifndef|if|elseif|else|endif|altmacro|noaltmacro)\\b"
                },
                {
                    "name": "keyword.control.directive.misc.gas-asm",
                    "match": "\\.(abort|err|error|fail|warning|print|include|incbin|func|endfunc|uleb128|sleb128|linkonce|symver|weakref|vtable_entry|vtable_inherit|gnu_attribute|attribute|code16|code16gcc|code32|code64)\\b"
                }
            ]
        },
        "instructions": {
            "patterns": [
                {
                    "name": "keyword.mnemonic.data-transfer.gas-asm",
                    "match": "\\b(mov|movb|movw|movl|movq|movabs|movabsq|movsx|movsxb|movsxw|movsxl|movsxd|movzx|movzb|movzw|movzl|lea|leaq|push|pushq|pop|popq|xchg|xchgb|xchgw|xchgl|xchgq)\\b"
                },
                {
                    "name": "keyword.mnemonic.arithmetic.gas-asm",
                    "match": "\\b(add|addb|addw|addl|addq|adc|adcb|adcw|adcl|adcq|sub|subb|subw|subl|subq|sbb|sbbb|sbbw|sbbl|sbbq|imul|imulb|imulw|imull|imulq|mul|mulb|mulw|mull|mulq|idiv|idivb|idivw|idivl|idivq|div|divb|divw|divl|divq|inc|incb|incw|incl|incq|dec|decb|decw|decl|decq|neg|negb|negw|negl|negq|cmp|cmpb|cmpw|cmpl|cmpq)\\b"
                },
                {
                    "name": "keyword.mnemonic.logic.gas-asm",
                    "match": "\\b(and|andb|andw|andl|andq|or|orb|orw|orl|orq|xor|xorb|xorw|xorl|xorq|not|notb|notw|notl|notq|test|testb|testw|testl|testq|bt|btb|btw|btl|btq|bts|btr|btc|bsf|bsr)\\b"
                },
                {
                    "name": "keyword.mnemonic.shift.gas-asm",
                    "match": "\\b(shl|shlb|shlw|shll|shlq|shr|shrb|shrw|shrl|shrq|sal|salb|salw|sall|salq|sar|sarb|sarw|sarl|sarq|rol|rolb|rolw|roll|rolq|ror|rorb|rorw|rorl|rorq|rcl|rcr|shld|shrd)\\b"
                },
                {
                    "name": "keyword.mnemonic.control.gas-asm",
                    "match": "\\b(jmp|jmpq|je|jz|jne|jnz|jg|jge|jl|jle|ja|jae|jb|jbe|jc|jnc|jo|jno|js|jns|jp|jpe|jnp|jpo|jcxz|jecxz|jrcxz|call|callq|ret|retq|retf|retn|leave|enter|loop|loope|loopz|loopne|loopnz)\\b"
                },
                {
                    "name": "keyword.mnemonic.string.gas-asm",
                    "match": "\\b(movs|movsb|movsw|movsl|movsq|cmps|cmpsb|cmpsw|cmpsl|cmpsq|scas|scasb|scasw|scasl|scasq|lods|lodsb|lodsw|lodsl|lodsq|stos|stosb|stosw|stosl|stosq|rep|repe|repz|repne|repnz)\\b"
                },
                {
                    "name": "keyword.mnemonic.flag.gas-asm",
                    "match": "\\b(stc|clc|cmc|std|cld|sti|cli|sahf|lahf|pushf|pushfq|popf|popfq)\\b"
                },
                {
                    "name": "keyword.mnemonic.misc.gas-asm",
                    "match": "\\b(nop|nopw|nopl|hlt|wait|pause|lock|int|int3|syscall|sysenter|sysexit|sysret|cpuid|rdtsc|rdtscp)\\b"
                },
                {
                    "name": "keyword.mnemonic.setcc.gas-asm",
                    "match": "\\b(sete|setz|setne|setnz|setg|setge|setl|setle|seta|setae|setb|setbe|setc|setnc|seto|setno|sets|setns|setp|setpe|setnp|setpo)\\b"
                },
                {
                    "name": "keyword.mnemonic.cmov.gas-asm",
